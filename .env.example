# Database configuration
# PostgreSQL format: postgresql+psycopg2://faulttrace_user:faulttrace_password@localhost:5432/faulttrace
# SQLite fallback: sqlite:///./faulttrace.db
DATABASE_URL=sqlite:///./faulttrace.db

# Environment mode
APP_ENV=development
DEBUG=True

# Weather integration flag (optional synthetic augmentation)
OPEN_METEO_ENABLED=False

# Pipeline parameters
CORRELATION_WINDOW_MINUTES=15
CALIBRATION_METHOD=isotonic
